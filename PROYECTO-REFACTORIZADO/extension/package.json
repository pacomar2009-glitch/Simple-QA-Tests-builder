{
  "name": "tests-analytics-extension",
  "version": "2.0.0",
  "description": "Chrome Extension para análisis y captura de interacciones de usuario con sistema de filtrado avanzado",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:phase1": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/phase1",
    "test:store": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=store.test.js",
    "test:badge": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=badge-manager.test.js",
    "test:state": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=state-service.test.js",
    "test:storage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=storage-service.test.js",
    "test:verbose": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "author": "Tests Analytics Team",
  "license": "MIT"
}
