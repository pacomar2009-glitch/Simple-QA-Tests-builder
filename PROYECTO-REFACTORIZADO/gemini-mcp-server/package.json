{
  "name": "gemini-mcp-playwright-runner",
  "version": "2.0.0",
  "description": "Sistema Agéntico Verdadero: Gemini usa MCP Protocol para controlar Playwright con loop observar-pensar-actuar-aprender",
  "main": "server-agentic-mcp.js",
  "scripts": {
    "start": "node server-agentic-mcp.js",

    "start:headless": "FORCE_HEADLESS=true node server-agentic-mcp.js",
    "start:head": "FORCE_HEADLESS=false node server-agentic-mcp.js",
    "dev": "nodemon server-agentic-mcp.js",
    "mcp:server": "node mcp-playwright-server.js",
    "agent:cli": "node gemini-agentic-loop.js",
    "test": "echo \"No tests yet\" && exit 0",
    "docker:build": "docker build -t gemini-mcp-playwright .",
    "docker:run": "docker run -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix -p 4000:4000 --name mcp-runner gemini-mcp-playwright",
    "docker:stop": "docker stop mcp-runner && docker rm mcp-runner"
  },
  "keywords": [
    "playwright",
    "gemini",
    "mcp",
    "test-automation",
    "docker",
    "microservice",
    "n8n",
    "test-generation"
  ],
  "author": "Tests-Analytics Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/mcp": "^0.0.42",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.40.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoaQA/Tests-Analytics.git"
  },
  "bugs": {
    "url": "https://github.com/LoaQA/Tests-Analytics/issues"
  },
  "homepage": "https://github.com/LoaQA/Tests-Analytics#readme"
}
