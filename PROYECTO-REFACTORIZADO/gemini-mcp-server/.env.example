# 🔐 Variables de entorno para gemini-mcp-playwright-runner v2.0

# === CONFIGURACIÓN OBLIGATORIA ===

# API Key de Google Gemini (REQUERIDA)
# Obtener en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === CONFIGURACIÓN OPCIONAL ===

# Puerto del servidor (default: 4000)
PORT=4000

# Modo del navegador
# false = Navegador visible (útil para desarrollo y debugging)
# true = Headless (recomendado para producción)
FORCE_HEADLESS=false

# Entorno de ejecución
NODE_ENV=development

# === CONFIGURACIÓN AVANZADA (OPCIONAL) ===

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5678,http://localhost:3000,http://localhost:8080

# Configuración de pantalla para X11 (Docker Linux)
DISPLAY=:0

# Nivel de logging (error, warn, info, verbose, debug)
LOG_LEVEL=info